{
    "name": "contenir/maintenance-laminas-mvc",
    "description": "Laminas MVC adapter for contenir/maintenance — short-circuits dispatch with 503 when maintenance mode is active.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "contenir/maintenance": "^0.1.0",
        "laminas/laminas-eventmanager": "^3.0",
        "laminas/laminas-http": "^2.0",
        "laminas/laminas-mvc": "^3.4",
        "laminas/laminas-servicemanager": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": { "Contenir\\Maintenance\\Laminas\\Mvc\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Contenir\\Maintenance\\Laminas\\Mvc\\Tests\\": "tests/" }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../contenir-maintenance",
            "canonical": false,
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/contenir/maintenance"
        }
    ],
    "extra": {
        "laminas": {
            "module": "Contenir\\Maintenance\\Laminas\\Mvc"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
